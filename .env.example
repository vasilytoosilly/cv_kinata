# ==============================================================
# Kinata Portfolio: Environment Variables
# For Local Development (.env.local) and Vercel Project Settings
# ==============================================================

# Supabase (Free Tier: https://supabase.com)
# Obtain these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Dashboard Passcode (Defaults to 'frozenpeak' if not set)
ADMIN_PASSWORD=frozenpeak
